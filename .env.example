# Example settings for local development. Copy to `.env` (gitignored) if you want to override defaults.
# Never put real secrets in this file — it is committed.
PORT=3000
MEMORA_LOG_LEVEL=debug
# MEMORA_DATA_DIR=./data
# Development only: where the web app's dev server (port 5173) sends /api. Without it, to the API
# that `pnpm dev` starts: http://127.0.0.1:<PORT>, where PORT comes from the environment (3000
# when unset). Read from the environment or from `.env`.
# MEMORA_DEV_API=http://127.0.0.1:3000
