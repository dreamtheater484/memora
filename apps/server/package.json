{
  "name": "@memora/server",
  "version": "0.9.4",
  "private": true,
  "description": "Memora API server. Bundled with esbuild: `dependencies` lists only what stays external at runtime.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "admin": "tsx src/admin-cli.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@memora/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
