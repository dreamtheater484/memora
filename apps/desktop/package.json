{
  "name": "@memora/desktop",
  "productName": "Memora",
  "desktopName": "memora.desktop",
  "version": "0.9.6",
  "private": true,
  "description": "Memora for your computer: the server and the web app in one app, with Electron.",
  "author": "Memora contributors",
  "license": "MIT",
  "homepage": "https://github.com/dreamtheater484/memora",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "resources": "node scripts/resources.mjs",
    "app:dir": "electron-builder --config electron-builder.config.cjs --dir --publish never",
    "app": "electron-builder --config electron-builder.config.cjs --publish never",
    "icon": "node scripts/icon.mjs",
    "test": "playwright test",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.2"
  }
}
