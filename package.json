{
  "name": "memora",
  "version": "0.9.0",
  "private": true,
  "description": "Self-hosted notebook with OneNote-style organisation, Markdown and rich notes, and Kanban boards.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "start": "pnpm --filter @memora/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @memora/web test:e2e",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update-snapshots",
    "check:privacy": "node scripts/check-forbidden.mjs && node scripts/check-git-identity.mjs",
    "check:bundle": "node scripts/bundle-size.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:privacy",
    "db:generate": "pnpm --filter @memora/server db:generate",
    "docker:build": "docker build -f docker/Dockerfile -t memora:local .",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
